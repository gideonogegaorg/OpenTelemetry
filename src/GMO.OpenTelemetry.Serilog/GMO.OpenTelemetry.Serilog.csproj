<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net48;net8.0;net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<PackageId>GMO.OpenTelemetry.Serilog</PackageId>
		<Description>Serilog integration for GMO.OpenTelemetry (.NET Framework 4.8 and .NET 8/9/10).</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
		<LangVersion>9.0</LangVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' != 'net48'">
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Serilog.Settings.Configuration" />
		<PackageReference Include="Serilog.Sinks.OpenTelemetry" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="GMO.OpenTelemetry.Tests" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\GMO.OpenTelemetry\GMO.OpenTelemetry.csproj" />
	</ItemGroup>
	
</Project>
