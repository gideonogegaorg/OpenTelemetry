<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net48;net8.0;net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<NoWarn>CS8618</NoWarn>
		<PackageId>GMO.OpenTelemetry</PackageId>
		<Description>OpenTelemetry instrumentation (runtime, process, custom CPU %) for .NET Framework 4.8 and .NET 8/9/10.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="GMO.OpenTelemetry.Tests" />
		<InternalsVisibleTo Include="GMO.OpenTelemetry.Serilog" />
		<InternalsVisibleTo Include="GMO.OpenTelemetry.Log4Net" />
		<InternalsVisibleTo Include="GMO.OpenTelemetry.SqlClient" />
		<InternalsVisibleTo Include="GMO.OpenTelemetry.Npgsql" />
	</ItemGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
		<LangVersion>9.0</LangVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' != 'net48'">
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
		<PackageReference Include="OpenTelemetry" />
		<PackageReference Include="OpenTelemetry.Api" />
		<PackageReference Include="OpenTelemetry.Exporter.Console" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Http" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Process" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'net48'">
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">
		<Reference Include="System.Web" />
		<PackageReference Include="System.Threading.Channels" />
	</ItemGroup>


</Project>
