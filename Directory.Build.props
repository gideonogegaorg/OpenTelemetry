<Project>
  <!-- Shared package metadata (GMO fork). CI overrides Version/AssemblyVersion/etc. -->
  <PropertyGroup>
    <Authors>Gideon Ogega</Authors>
    <Company>Gideon Ogega</Company>
    <RepositoryUrl>https://github.com/gideonogegaorg/OpenTelemetry</RepositoryUrl>
    <PackageProjectUrl>https://github.com/gideonogegaorg/OpenTelemetry</PackageProjectUrl>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Compile-time polyfills (Index/Range, nullable attributes) for net48; generates internal source, no runtime dependency. -->
  <ItemGroup>
    <PackageReference Include="PolySharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
